# ==============================================================================
# ODISHA COMPETITIVE INSTITUTE (OCI) — PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Architecture: Vercel (Frontends) + Cloudflare (DNS/CDN/WAF) + R2 (Storage) + Supabase (Backend)
# Note: Configure these variables within Vercel Project Settings and Supabase Dashboard.
# NEVER commit real production secrets, service-role keys, or R2 credentials to Git.

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL & Auth Platform
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ------------------------------------------------------------------------------
# 2. Cloudflare R2 Storage (S3-Compatible Object Store)
# ------------------------------------------------------------------------------
# Cloudflare Account ID & R2 API Tokens (Created in Cloudflare Dashboard -> R2)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# R2 Public Distribution Custom Domains (Connected via Cloudflare DNS)
R2_PUBLIC_DOMAIN=https://cdn.ociinstitute.com
R2_DOWNLOAD_DOMAIN=https://download.ociinstitute.com

# R2 Bucket Names
R2_BUCKET_PUBLIC_ASSETS=oci-public-assets
R2_BUCKET_APP_RELEASES=oci-app-releases
R2_BUCKET_STUDY_MATERIALS=oci-study-materials
R2_BUCKET_ASSIGNMENTS=oci-assignments
R2_BUCKET_MEDIA=oci-media

# ------------------------------------------------------------------------------
# 3. Domain & Routing Architecture
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.ociinstitute.com
NEXT_PUBLIC_ADMIN_URL=https://admin.ociinstitute.com
NEXT_PUBLIC_CDN_URL=https://cdn.ociinstitute.com
NEXT_PUBLIC_DOWNLOAD_URL=https://download.ociinstitute.com

# ------------------------------------------------------------------------------
# 4. Institute Contact & Brand Metadata
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="Odisha Competitive Institute"
NEXT_PUBLIC_SITE_TAGLINE="Your Goal. Our Guidance. Your Success."
NEXT_PUBLIC_SITE_PHONE="7205021878"
NEXT_PUBLIC_SITE_WHATSAPP="7655004403"

# ------------------------------------------------------------------------------
# 5. Live Classroom (Jitsi Meet Infrastructure)
# ------------------------------------------------------------------------------
JITSI_SERVER_URL=https://meet.jit.si
JITSI_DOMAIN=meet.jit.si

# ------------------------------------------------------------------------------
# 6. Global Environment & Runtime
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production
