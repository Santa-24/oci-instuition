# ==============================================================================
# ODISHA COMPETITIVE INSTITUTE (OCI) — MASTER ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# All variables below should be configured within their respective deployment platforms:
# Vercel (Frontends) | Render (Backend API) | Supabase (Data Platform) | Firebase | Upstash

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL & Auth Platform
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 2. Render Backend API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.oci-domain.com
SERVER_PORT=8080
FRONTEND_URL=https://www.oci-domain.com
CORS_ALLOWED_ORIGINS=https://www.oci-domain.com,https://admin.oci-domain.com

# ------------------------------------------------------------------------------
# 3. Upstash Redis (Caching & Rate Limiting)
# ------------------------------------------------------------------------------
REDIS_URL=https://your-instance.upstash.io
REDIS_TOKEN=your_upstash_redis_token_here

# ------------------------------------------------------------------------------
# 4. Firebase Cloud Messaging (Push Notifications)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key_here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_fcm_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_firebase_web_push_vapid_key_here

FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="your_firebase_service_account_private_key_here"

# ------------------------------------------------------------------------------
# 5. Jitsi Meet Classroom Server
# ------------------------------------------------------------------------------
JITSI_SERVER_URL=https://meet.jit.si
JITSI_DOMAIN=meet.jit.si

# ------------------------------------------------------------------------------
# 6. Global Environment
# ------------------------------------------------------------------------------
NODE_ENV=production
ENVIRONMENT=production
