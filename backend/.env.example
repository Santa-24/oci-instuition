# ==============================================================================
# OCI PRODUCTION BACKEND — RENDER ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Fill in real values within the Render dashboard settings. Do NOT commit secrets to Git.

# Server Environment
SERVER_PORT=8080
PORT=8080
NODE_ENV=production

# Supabase Server-Side Connection (Never expose SECRET_KEY to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here

# Upstash Redis (Optional for caching and rate-limiting)
REDIS_URL=https://your-upstash-instance.upstash.io
REDIS_TOKEN=your_upstash_redis_rest_token_here

# Firebase Cloud Messaging (FCM Server Credentials)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"

# Client Origins & CORS
FRONTEND_URL=https://www.oci-domain.com
CORS_ALLOWED_ORIGINS=https://www.oci-domain.com,https://admin.oci-domain.com

# JWT & Security
JWT_SECRET=your_jwt_signing_secret_here
