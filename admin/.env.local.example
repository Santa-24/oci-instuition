# ==============================================================================
# OCI MASTER ADMIN — VERCEL PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Configure these in Vercel -> Project Settings -> Environment Variables.

# 1. Supabase Client & Service Role (Server-Only Secret)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# 2. Cloudflare R2 Storage (S3-Compatible Object Store)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# R2 Distribution Domains & Buckets
R2_PUBLIC_DOMAIN=https://cdn.ociinstitute.com
R2_DOWNLOAD_DOMAIN=https://download.ociinstitute.com
R2_BUCKET_PUBLIC_ASSETS=oci-public-assets
R2_BUCKET_APP_RELEASES=oci-app-releases
R2_BUCKET_STUDY_MATERIALS=oci-study-materials
R2_BUCKET_ASSIGNMENTS=oci-assignments
R2_BUCKET_MEDIA=oci-media

# 3. Environment & Host Names
NEXT_PUBLIC_SITE_NAME="OCI Master Admin Console"
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://www.ociinstitute.com
NEXT_PUBLIC_ADMIN_URL=https://admin.ociinstitute.com
NODE_ENV=production
